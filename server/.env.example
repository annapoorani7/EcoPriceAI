# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecopriceai?replicaSet=rs0

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:3000
ML_SERVICE_URL=http://127.0.0.1:5001/predict-price

# Ticketmaster API (Optional External Source)
# Get your Ticketmaster Consumer Key from: https://developer.ticketmaster.com/
# Leave empty or set to placeholder to disable Ticketmaster integration
EVENTS_API_URL=https://app.ticketmaster.com/discovery/v2/events.json
EVENTS_API_KEY=your_ticketmaster_consumer_key_here

# Weather Service
WEATHER_API_KEY=your_openweathermap_api_key_here

# Event Source (Legacy - can be left empty)
EVENT_SOURCE_URL=
